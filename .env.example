# Copy this file to .env and fill in real values. Never commit .env.
# Where noted, a value is not read by the code yet — it documents what to
# collect for a change that's coming (see comment on that line).

# --- Database ---------------------------------------------------------
# MongoDB Atlas (or self-hosted) connection string.
MONGO_URI="mongodb+srv://<username>:<password>@<cluster-host>/?appName=Cluster0"
# MONGO_URI="mongodb://<host>:27017"

# --- Server -------------------------------------------------------------
PORT=3000
HOST="localhost"

NODE_ENV=local # development | local

IMAGES_PATH=../../../images

# --- Outbound email (SMTP) ----------------------------------------------
SMTP_HOST="smtp.example.com"
SMTP_PORT=465
SMTP_USER="no-reply@example.com"
SMTP_PASS="<smtp-password>"
EMAIL_FROM_NAME="212 Messenger"
DEFAULT_EMAIL_FROM="no-reply@example.com"

# --- AWS S3 (media storage) ----------------------------------------------
# IAM user access key with S3 read/write on the bucket below.
AWS_ACCESS_KEY_ID="<aws-access-key-id>"
AWS_SECRET_ACCESS_KEY="<aws-secret-access-key>"
AWS_REGION="eu-west-2"
AWS_S3_BUCKET_NAME="<s3-bucket-name>"

# --- Agora (voice/video call RTC tokens) ---------------------------------
# Agora Console → Project Management → your project → App ID / App Certificate
# (Primary Certificate must be enabled, not just App ID).
APP_ID="<agora-app-id>"
APP_CERTIFICATE="<agora-app-certificate>"

# --- Firebase Admin SDK (Android/iOS push notifications) -----------------
# Firebase Console → Project settings → Service accounts → Generate new
# private key. Paste the downloaded JSON here as a single-quoted string.
FIREBASE_CREDENTIALS='{
  "type": "service_account",
  "project_id": "<firebase-project-id>",
  "private_key_id": "<private-key-id>",
  "private_key": "-----BEGIN PRIVATE KEY-----\n<private-key-contents>\n-----END PRIVATE KEY-----\n",
  "client_email": "firebase-adminsdk@<project-id>.iam.gserviceaccount.com",
  "client_id": "<client-id>",
  "auth_uri": "https://accounts.google.com/o/oauth2/auth",
  "token_uri": "https://oauth2.googleapis.com/token",
  "auth_provider_x509_cert_url": "https://www.googleapis.com/oauth2/v1/certs",
  "client_x509_cert_url": "https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk%40<project-id>.iam.gserviceaccount.com",
  "universe_domain": "googleapis.com"
}'

# --- Apple Push Notification service (iOS VoIP calling) ------------------
# Required for incoming calls to ring on iOS via CallKit/PushKit when the
# app is backgrounded or killed (FCM alone can't deliver a VoIP push type).
# Leave APNS_KEY_ID/APNS_AUTH_KEY blank to disable — the server will log a
# warning and skip VoIP pushes rather than fail.
#
# Apple Developer → Certificates, Identifiers & Profiles → Keys → create a
# key with "Apple Push Notifications service (APNs)" enabled, download the
# .p8 once, and note its Key ID + your Team ID.
APNS_KEY_ID="<apns-auth-key-id>"
APNS_TEAM_ID="<apple-developer-team-id>"
APNS_BUNDLE_ID="com.freshcodes.twoonetwomessenger"
APNS_ENVIRONMENT=development # development (sandbox) | production
# Contents of the downloaded AuthKey_<APNS_KEY_ID>.p8 file, newlines escaped
# as \n the same way FIREBASE_CREDENTIALS.private_key is above.
APNS_AUTH_KEY="-----BEGIN PRIVATE KEY-----\n<apns-p8-key-contents>\n-----END PRIVATE KEY-----\n"

# --- Misc ------------------------------------------------------------
# Passphrase protecting the server-side RSA key used for chat encryption.
RSA_PASSPHRASE="<rsa-passphrase>"
